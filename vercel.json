{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": {
            "inc": ["l2kedu.cloud", "www.l2kedu.cloud"]
          }
        }
      ],
      "dest": "/l2k-edu/index.html"
    },
    {
      "src": "^/(?!auth-callback\\.(?:html|css|js)$|supabase-client\\.js$)(.*)$",
      "has": [
        {
          "type": "host",
          "value": {
            "inc": ["l2kedu.cloud", "www.l2kedu.cloud"]
          }
        }
      ],
      "dest": "/l2k-edu/$1"
    }
  ]
}
