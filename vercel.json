{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "l2kedu.cloud" }],
      "destination": "/l2k-edu/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "l2kedu.cloud" }],
      "destination": "/l2k-edu/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.l2kedu.cloud" }],
      "destination": "/l2k-edu/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.l2kedu.cloud" }],
      "destination": "/l2k-edu/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
